{
  "name": "octo",
  "version": "0.0.0",
  "private": true,
  "description": "A notebook environment for agents, built on pi",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "octo": "dist/cli/octo.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck",
    "test": "vitest run",
    "octo": "npm run build && node dist/cli/npm-octo.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "8.10.2",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
